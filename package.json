{
  "name": "solid-pulse-monorepo",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "examples/*"],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "test": "bun --conditions=browser --conditions=development test packages",
    "typecheck": "bunx tsc -p packages/solid-pulse --noEmit && bunx tsc -p packages/scenario-sim --noEmit",
    "check": "bun run build && bun run test && bun run typecheck"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^16.0.0",
    "@types/bun": "latest",
    "@types/node": "^22",
    "solid-js": "^1.9.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vite": "^7.0.0"
  }
}
