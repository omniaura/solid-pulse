{
  "name": "solid-pulse-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "test": "bun run test:unit && bun run test:e2e",
    "typecheck": "bunx tsc -p packages/solid-pulse --noEmit && bunx tsc -p examples/basic --noEmit",
    "check": "bun run build && bun run test && bun run typecheck",
    "test:unit": "bun --conditions=browser --conditions=development test packages/solid-pulse/tests",
    "test:e2e": "bun --conditions=browser --conditions=development test packages/solid-pulse/e2e",
    "smoke": "bash scripts/smoke.sh"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@types/bun": "latest",
    "@types/node": "^22",
    "happy-dom": "^20.14.5",
    "solid-js": "2.0.0-rc.18",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vite": "^8.0.0",
    "@semantic-release/git": "^10.0.1",
    "semantic-release": "25",
    "@solidjs/web": "2.0.0-rc.18",
    "@tanstack/solid-query": "6.0.0-rc.5",
    "@tanstack/solid-query-devtools": "6.0.0-rc.5"
  }
}
